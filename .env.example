# ---- Lovable Sales Portal (Supabase) ----
# Project: SALES PORTAL (fa5411e5-7243-44d6-b4ab-463b894b09f9)
SUPABASE_URL=https://zrrndxdnopvgspyhrsxh.supabase.co
# Service-role (secret) key from Lovable Cloud -> Settings -> API. Never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Booking page prospects are sent to (Google Calendar appointment schedule, Calendly, ...) ----
# Leave empty to skip booking links. UTM parameters identifying the lead are appended automatically.
LEADGEN_BOOKING_URL=

# ---- Discovery providers (all optional: Wayback/Common Crawl/crt.sh/OpenStreetMap need no key) ----
# ANTHROPIC_API_KEY below also acts as a search provider via Claude web search.
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_KEY=
SEMRUSH_API_KEY=

# ---- Enrichment providers (all optional) ----
# People-data providers for founders' direct emails / mobiles / LinkedIn (see README):
APOLLO_API_KEY=
APOLLO_PHONE_WEBHOOK_URL=
LUSHA_API_KEY=
HUNTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---- Crawler behaviour ----
LEADGEN_DB=./leads.db
LEADGEN_USER_AGENT=MyOrbitHealth-LeadResearch/0.1 (+https://myorbithealth.com)
LEADGEN_MIN_DELAY_SECONDS=2.0
LEADGEN_MAX_PAGES_PER_SITE=8
LEADGEN_RESPECT_ROBOTS=true
